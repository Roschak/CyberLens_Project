# Build output
bin/
obj/
publish/
**/bin/
**/obj/
**/publish/

# Runtime data & secrets (created on first run)
# NOTE: ignore the SQLite file only (and WAL/SHM) — the folder name `data/` must NOT be ignored
# as a directory, or it silently swallows the source folder `Data/` on Windows
# (case-insensitive matching) and the database/entity layer never gets committed.
**/data/cyberlens.db*
**/config/cyberlens.settings.json
**/storage/*
!**/storage/.gitkeep

# Keep directory structures and templates
!**/config/cyberlens.settings.example.json
!**/config/.gitkeep
!**/data/.gitkeep

# IDE & Editor files
.vs/
.idea/
.vscode/
*.user
*.userosv
*.suo
*.sln.docstates

# Environment & local settings
.env
.env.*
*.local.json
!settings.local.json

# Logs & temp files
*.log
logs/
TestResults/

# OS
.DS_Store
Thumbs.db
